# EdgeShell environment. Copy to .env and fill in. NEVER commit .env.

# ── Deployment (read by `sudo python3 run.py` on the EC2 host) ─────────
# Subdomain pointing (A record) at the instance's static IP. Blank = serve on IP.
EDGESHELL_DOMAIN=
# Email for Let's Encrypt. Blank = HTTP only.
LETSENCRYPT_EMAIL=
# Display timezone for the UI and server clock. DB always stores UTC.
DISPLAY_TZ=Asia/Kolkata
SET_SYSTEM_TZ=true
# phpMyAdmin port on the Tailscale IP (never opened publicly).
PMA_PORT=8080
# Enforce per-user session limits (set per user by an admin, 1-4 devices,
# default 1). A login past the limit signs out the oldest device.
SINGLE_SESSION=true

# ── Flask ──────────────────────────────────────────────────────────────
# development = friendly local/LAN run over HTTP (secure cookies off).
# production  = hardened; requires SECRET_KEY + CREDENTIAL_KEY; secure cookies on.
FLASK_ENV=development
FLASK_DEBUG=false

# ── Security (REQUIRED in production; app refuses to start without these) ──
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_char_random_secret_key
CREDENTIAL_KEY=CHANGE_ME_generate_a_32_char_credential_key

# ── Database ───────────────────────────────────────────────────────────
# SQLite (default, WAL enabled automatically):
DATABASE_URL=sqlite:///instance/edgeshell.db
# PostgreSQL:  DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/edgeshell
# MariaDB (set automatically by run.py in production):
#   DATABASE_URL=mysql+mysqlconnector://user:pass@localhost/edgeshell?unix_socket=/run/mysqld/mysqld.sock&charset=utf8mb4

# ── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
# Secure session cookie needs HTTPS. Over plain HTTP on a LAN IP the browser
# drops it and login fails with 'CSRF session token is missing'. Leave false
# for HTTP; set true once TLS terminates in front (reverse proxy / ALB).
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# "Still there?" prompt after IDLE_MINUTES without interaction, sign-out
# IDLE_WARNING_MINUTES later (0 turns it off).
IDLE_MINUTES=10
IDLE_WARNING_MINUTES=5
# Anyone may request an account; an administrator approves it with a role.
SIGNUP_ENABLED=true

# ── Two-factor authentication (mandatory) ─────────────────────────────
# Codes are checked by privacyIDEA when PRIVACYIDEA_URL is set (the Docker
# stack runs it in its own container), otherwise by the built-in verifier.
# PRIVACYIDEA_URL=http://privacyidea:8080
# PRIVACYIDEA_ADMIN=edgeshell
# PRIVACYIDEA_PASSWORD=
# MFA_ISSUER=EdgeShell

# ── Password reset email for administrators (any SMTP server) ─────────
# PUBLIC_URL is the address users open; links are never built from the
# request. run.py sets it when a domain with TLS is configured.
# PUBLIC_URL=https://fleet.yourdomain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=EdgeShell <noreply@yourdomain.com>
# SMTP_SECURITY=starttls

# Behind >1 gunicorn worker, use a shared rate-limit store:
# RATELIMIT_STORAGE_URI=redis://redis:6379

# ── VPN / mesh ─────────────────────────────────────────────────────────
# tailscale | wireguard
VPN_BACKEND=tailscale
WIREGUARD_INTERFACE=wg0
TAILSCALE_AUTH_KEY=tskey-auth-your-key-here

# ── Integrations ───────────────────────────────────────────────────────
ORGUI_REPO=https://github.com/855princekumar/OpenRemoteGUI.git
ORGUI_DEFAULT_PORT=6080
NODERED_DEFAULT_PORT=1880
METRICS_RETENTION_DAYS=14

# ── Email notifications (useSend, open-source) ─────────────────────────
# Tickets email the other party when raised or replied to. Off by default.
EMAIL_ENABLED=false
# Hosted useSend: https://app.usesend.com  |  self-hosted: your instance URL
USESEND_BASE_URL=https://app.usesend.com
USESEND_API_KEY=us_your_api_key_here
USESEND_FROM=EdgeShell <noreply@yourdomain.com>
