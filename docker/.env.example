# EdgeShell settings for docker/compose.yaml. Keep this file private: chmod 600 .env
#
# Fill the eight secrets with:
#   for k in SECRET_KEY CREDENTIAL_KEY DB_PASSWORD DB_ROOT_PASSWORD MFA_ADMIN_PASSWORD MFA_PEPPER MFA_DB_PASSWORD MFA_SECRET_KEY; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env; done
# Back up this file with ./data: CREDENTIAL_KEY decrypts the stored node
# passwords, and ./data/privacyidea holds the key for the 2FA token secrets.

# Leave EDGESHELL_DOMAIN empty to serve plain HTTP on the server's IP, or set
# it to the server's public IPv4 address for a free Let's Encrypt IP
# certificate (short-lived, renewed automatically; needs a static IP).
# With a domain (DNS A record -> this host, ports 80 and 443 open): set it,
# ACME_EMAIL, SESSION_COOKIE_SECURE=true and PUBLIC_URL=https://<domain>,
# then `docker compose up -d`. certbot gets the certificate and nginx
# switches to HTTPS by itself.
EDGESHELL_DOMAIN=
ACME_EMAIL=
SESSION_COOKIE_SECURE=false

# Secrets (required). Hex values only, so they are safe inside the database URL.
SECRET_KEY=
CREDENTIAL_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# privacyIDEA (2FA): its service account, password pepper and database user.
MFA_ADMIN_PASSWORD=
MFA_PEPPER=
MFA_DB_PASSWORD=
MFA_SECRET_KEY=

# Image version. Change and run `docker compose up -d` to upgrade.
EDGESHELL_TAG=1.17.0

# MQTT heartbeat through SenseHive (docs/HEARTBEAT.md). Generate both with
#   openssl rand -hex 32
# and keep them secret: the master key gives every node its own keys at install
# time (it is never sent to a node); the token lets EdgeShell read SenseHive.
# Empty = heartbeat off (nodes are still monitored over SSH as before).
HEARTBEAT_MASTER_KEY=
SENSEHIVE_API_TOKEN=
# First password of SenseHive's own admin user (new database only); empty =
# admin123, change it at the first sign-in.
SENSEHIVE_ADMIN_PASSWORD=
# HEARTBEAT_BROKER=broker.hivemq.com
# HEARTBEAT_PORT=8883
# HEARTBEAT_TLS=true
# The broker login every node's agent uses (default admin / admin123). Set your
# own on your broker and here, then Fleet Setup, Push to every node.
# HEARTBEAT_BROKER_USERNAME=admin
# HEARTBEAT_BROKER_PASSWORD=admin123
# Nodes the heartbeat routine handles per pass (install, update, repair)
# HEARTBEAT_ROUTINE_MAX=25

# Email: address verification, password reset links for every user, ticket
# notices. PUBLIC_URL is the address people open (links are never built from
# the request); SMTP is any mail server. Free options (Resend, Brevo, useSend,
# Gmail) and step-by-step setup: docs/EMAIL.md
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Sessions: "still there?" prompt after IDLE_MINUTES without a click or key
# press, signed out IDLE_WARNING_MINUTES later. 0 turns it off.
IDLE_MINUTES=10
IDLE_WARNING_MINUTES=5
# Anyone can request an account; an administrator approves it with a role.
SIGNUP_ENABLED=true

# Optional
DISPLAY_TZ=UTC
SESSION_HOURS=8
SINGLE_SESSION=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
METRICS_RETENTION_DAYS=14
# Node login policy: pause automatic logins after this many password failures,
# re-check paused nodes this often (no password is sent for the check)
LOGIN_PAUSE_AFTER_FAILURES=2
LOGIN_RECHECK_MINUTES=30
# Public API (docs/API.md): commands off by default; per-credential limits by role
API_ALLOW_COMMANDS=false
API_RATE_LIMIT_MONITOR=300 per minute
API_RATE_LIMIT_OPERATOR=600 per minute
API_RATE_LIMIT_ADMIN=1200 per minute
API_SESSION_IDLE_MINUTES=60
API_SESSION_MAX_HOURS=12
# Event feed kept on the hot database (the data lake keeps it for good)
EVENT_RETENTION_DAYS=90
