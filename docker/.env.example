# EdgeShell settings for docker/compose.yaml. Keep this file private: chmod 600 .env
#
# Fill the seven secrets with:
#   for k in SECRET_KEY CREDENTIAL_KEY DB_PASSWORD DB_ROOT_PASSWORD MFA_ADMIN_PASSWORD MFA_PEPPER MFA_DB_PASSWORD; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env; done
# Back up this file with ./data: CREDENTIAL_KEY decrypts the stored node
# passwords, and ./data/privacyidea holds the key for the 2FA token secrets.

# Public hostname (DNS A record -> this host) and the email for Let's Encrypt.
EDGESHELL_DOMAIN=fleet.example.com
ACME_EMAIL=admin@example.com
# Keep true with a domain (HTTPS). No domain yet: EDGESHELL_DOMAIN=:80 and
# SESSION_COOKIE_SECURE=false serve plain HTTP on the IP until you add one.
SESSION_COOKIE_SECURE=true

# Secrets (required). Hex values only, so they are safe inside the database URL.
SECRET_KEY=
CREDENTIAL_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# privacyIDEA (2FA): its service account, password pepper and database user.
MFA_ADMIN_PASSWORD=
MFA_PEPPER=
MFA_DB_PASSWORD=

# Image version. Change and run `docker compose up -d` to upgrade.
EDGESHELL_TAG=1.3.0

# Password reset links for administrators. PUBLIC_URL is the address people
# open (links are never built from the request); SMTP is any mail server:
# Gmail (app password), AWS SES, Brevo, Mailgun, your own.
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Sessions: "still there?" prompt after IDLE_MINUTES without a click or key
# press, signed out IDLE_WARNING_MINUTES later. 0 turns it off.
IDLE_MINUTES=10
IDLE_WARNING_MINUTES=5
# Anyone can request an account; an administrator approves it with a role.
SIGNUP_ENABLED=true

# Optional
DISPLAY_TZ=UTC
SESSION_HOURS=8
SINGLE_SESSION=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
METRICS_RETENTION_DAYS=14
