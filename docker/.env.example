# EdgeShell settings for docker/compose.yaml. Keep this file private: chmod 600 .env
#
# Fill the four secrets with:
#   for k in SECRET_KEY CREDENTIAL_KEY DB_PASSWORD DB_ROOT_PASSWORD; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env; done
# Back up this file with ./data: CREDENTIAL_KEY decrypts the stored node passwords.

# Public hostname (DNS A record -> this host) and the email for Let's Encrypt.
EDGESHELL_DOMAIN=fleet.example.com
ACME_EMAIL=admin@example.com

# Secrets (required). Hex values only, so they are safe inside the database URL.
SECRET_KEY=
CREDENTIAL_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Image version. Change and run `docker compose up -d` to upgrade.
EDGESHELL_TAG=1.2.0

# Optional
DISPLAY_TZ=UTC
SESSION_HOURS=8
SINGLE_SESSION=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
METRICS_RETENTION_DAYS=14
