# Shell scripts and container files must keep LF endings: CRLF breaks them
# inside Linux containers and on the EC2 host.
* text=auto
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.svg text eol=lf
*.png binary
*.ico binary
